<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Version Condition="'$(TargetFramework)' == 'net9.0'">1.0.1</Version>
    <AssemblyVersion Condition="'$(TargetFramework)' == 'net9.0'">1.0.1.0</AssemblyVersion>
    <Version Condition="'$(TargetFramework)' == 'net10.0'">1.1.1</Version>
    <AssemblyVersion Condition="'$(TargetFramework)' == 'net10.0'">1.1.1.0</AssemblyVersion>
    <RootNamespace>Jellyfin.Plugin.FinishBy</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" Condition="'$(TargetFramework)' == 'net9.0'">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.11" Condition="'$(TargetFramework)' == 'net9.0'">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Controller" Version="12.4.0" Condition="'$(TargetFramework)' == 'net10.0'">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.4.0" Condition="'$(TargetFramework)' == 'net10.0'">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Configuration/configPage.html" />
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
</Project>
